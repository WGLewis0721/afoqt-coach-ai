    "id": "math-01",
    "deck": "math",
    "front": "Distance, rate, time",
    "back": "d = r × t"
  },
  {
    "id": "math-02",
    "deck": "math",
    "front": "Average speed (different times per leg)",
    "back": "total distance ÷ total time — NOT the average of the two speeds"
  },
  {
    "id": "math-03",
    "deck": "math",
    "front": "Work rate (two people/pipes together)",
    "back": "1/a + 1/b = 1/t"
  },
  {
    "id": "math-04",
    "deck": "math",
    "front": "Percent of a number",
    "back": "part = (pct/100) × whole"
  },
  {
    "id": "math-05",
    "deck": "math",
    "front": "Percent change",
    "back": "(new − old) / old × 100"
  },
  {
    "id": "math-06",
    "deck": "math",
    "front": "Successive discounts (e.g. 20% off, then 10% off)",
    "back": "Multiply the remaining factors: 0.8 × 0.9 = 0.72 of the original — don't just add the percents"
  },
  {
    "id": "math-07",
    "deck": "math",
    "front": "Ratio / proportion",
    "back": "a/b = c/d → cross-multiply: ad = bc"
  },
  {
    "id": "math-08",
    "deck": "math",
    "front": "Mixture problems",
    "back": "value = amount × concentration; combining: c1v1 + c2v2 = cf(v1+v2)"
  },
  {
    "id": "math-09",
    "deck": "math",
    "front": "Simple interest",
    "back": "I = P r t (r as a decimal, t in years)"
  },
  {
    "id": "math-10",
    "deck": "math",
    "front": "Compound interest",
    "back": "A = P(1+r)^t"
  },
  {
    "id": "math-11",
    "deck": "math",
    "front": "Exponent rules: multiplying/dividing",
    "back": "a^m·a^n = a^(m+n); a^m/a^n = a^(m−n)"
  },
  {
    "id": "math-12",
    "deck": "math",
    "front": "Exponent rules: power of a power, zero, negative",
    "back": "(a^m)^n = a^(mn); a^0 = 1 (a≠0); a^(−n) = 1/a^n"
  },
  {
    "id": "math-13",
    "deck": "math",
    "front": "Radical rules",
    "back": "√(ab) = √a·√b; √(a/b) = √a/√b; √a·√a = a"
  },
  {
    "id": "math-14",
    "deck": "math",
    "front": "Quadratic formula",
    "back": "x = [−b ± √(b²−4ac)] / (2a)"
  },
  {
    "id": "math-15",
    "deck": "math",
    "front": "Discriminant (b²−4ac)",
    "back": "Positive → two real roots. Zero → one root. Negative → no real roots."
  },
  {
    "id": "math-16",
    "deck": "math",
    "front": "FOIL",
    "back": "(x+a)(x+b) = x² + (a+b)x + ab"
  },
  {
    "id": "math-17",
    "deck": "math",
    "front": "Inequalities — the one everyone forgets",
    "back": "Multiplying or dividing by a negative flips the inequality sign"
  },
  {
    "id": "math-18",
    "deck": "math",
    "front": "Absolute value equation |x| = a",
    "back": "x = a OR x = −a (when a ≥ 0)"
  },
  {
    "id": "math-19",
    "deck": "math",
    "front": "Slope formula",
    "back": "m = (y2−y1)/(x2−x1)"
  },
  {
    "id": "math-20",
    "deck": "math",
    "front": "Slope-intercept form",
    "back": "y = mx + b"
  },
  {
    "id": "math-21",
    "deck": "math",
    "front": "Distance between two points",
    "back": "√[(x2−x1)² + (y2−y1)²]"
  },
  {
    "id": "math-22",
    "deck": "math",
    "front": "Parallel vs. perpendicular slopes",
    "back": "Parallel: equal slopes. Perpendicular: negative reciprocal slopes."
  },
  {
    "id": "math-23",
    "deck": "math",
    "front": "Pythagorean theorem",
    "back": "a² + b² = c² (right triangles only)"
  },
  {
    "id": "math-24",
    "deck": "math",
    "front": "45-45-90 triangle sides",
    "back": "legs = x, hypotenuse = x√2"
  },
  {
    "id": "math-25",
    "deck": "math",
    "front": "30-60-90 triangle sides",
    "back": "short leg = x, long leg = x√3, hypotenuse = 2x — the long leg is x√3, NOT 2x"
  },
  {
    "id": "math-26",
    "deck": "math",
    "front": "Area of a triangle",
    "back": "A = (1/2) b h"
  },
  {
    "id": "math-27",
    "deck": "math",
    "front": "Circle formulas",
    "back": "Circumference C = 2πr = πd; Area A = πr²"
  },
  {
    "id": "math-28",
    "deck": "math",
    "front": "Sphere volume & surface area",
    "back": "V = (4/3)πr³; SA = 4πr²"
  },
  {
    "id": "math-29",
    "deck": "math",
    "front": "Mental math: 15% of a number",
    "back": "Find 10%, then add half of that (which is 5%)"
  },
  {
    "id": "math-30",
    "deck": "math",
    "front": "Mental math: multiplying by 25",
    "back": "n × 25 = n × 100 ÷ 4"
  },
